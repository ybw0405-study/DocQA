# ---------------------------------------------------------------
# DocQA · 仓库忽略规则
# 原则：只提交「源码 + 文档 + 取证材料」，构建产物与本机环境一律不入库
# ---------------------------------------------------------------

# --- 操作系统 / IDE ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.iml
*.ipr
*.iws

# --- Java / Maven ---
target/
*.class
*.jar
*.war
*.ear
hs_err_pid*.log
replay_pid*.log

# --- Node / 前端 ---
node_modules/
frontend-vue/dist/
frontend-vue/reports/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- 本地运行产物 / 取证中间件 ---
.artifacts/
*.log
logs/
tmp/
.tmp/

# --- 本机环境与凭据（红线：仓库内不出现真实凭据）---
.env
.env.*
!.env.example
ops/env/local.env
ops/backup/
*.pem
*.key
*.p12
*.pfx
secrets/
*_secret*
!docs/**/*secret*.md

# --- 压缩包 / 临时文件 ---
*.zip
*.7z
*.tar.gz
~$*
