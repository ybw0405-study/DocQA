# DocQA 本地开发配置模板
#
# 用法：复制本文件为同目录下的 local.env（gitignored），按需填写。
#   Copy-Item ops/env/local.env.example ops/env/local.env
# start-dev.ps1 会逐行读取 local.env 并注入「进程作用域」环境变量，
# 脚本退出后变量即消失；本文件是唯一事实来源，不再写 Windows User/Machine 全局作用域。
#
# 端口段与 AgentFlow 完全错开，两个项目可以同时启动：
#   MySQL 13306 / PG 15432 / Redis 16380 / MinIO 19100,19101
#   RocketMQ 19876,20911,20909 / Python 18000 / Java 18080-18083 / Vite 5173
# 全部绑定 127.0.0.1，地址永不漂移（不再依赖 WSL eth0 IP）。
#
# 注意：值里的 # ? % @ $ 都是字面量，解析器只跳过「行首 #」的注释行，
# 不做行内注释剥离，不要给值加引号。

# ===== 数据库 =====
DOCQA_DB_URL=jdbc:mysql://127.0.0.1:13306/docqa?useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=utf8
DOCQA_DB_USERNAME=root
DOCQA_DB_PASSWORD=CHANGE_ME_ROOT_PASSWORD
DOCQA_APP_DB_USERNAME=ss_app
DOCQA_APP_DB_PASSWORD=CHANGE_ME_APP_PASSWORD
DOCQA_MIGRATOR_DB_USERNAME=ss_migrator
DOCQA_MIGRATOR_DB_PASSWORD=CHANGE_ME_MIGRATOR_PASSWORD
DOCQA_AUDIT_DB_USERNAME=ss_audit
DOCQA_AUDIT_DB_PASSWORD=CHANGE_ME_AUDIT_PASSWORD

# ===== 中间件端点 =====
DOCQA_REDIS_HOST=127.0.0.1
DOCQA_REDIS_PORT=16380
DOCQA_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
DOCQA_MINIO_ENDPOINT=http://127.0.0.1:19100
DOCQA_MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
DOCQA_MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
DOCQA_MINIO_BUCKET=docqa-documents
DOCQA_ROCKETMQ_NAMESRV=127.0.0.1:19876

# ===== 应用配置 =====
DOCQA_JWT_SECRET=CHANGE_ME_JWT_SECRET
DOCQA_DEMO_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH
DOCQA_COOKIE_SECURE=false
DOCQA_AUDIT_APPEND_ONLY_GUARD=warn
# 可选：租户供给 bootstrap 端点令牌，留空即禁用（默认安全，勿提交真实值）。
# 需要供给第二个真实租户时才填写高熵值，并走 out-of-band 运维直连 user-service。
# DOCQA_TENANT_BOOTSTRAP_TOKEN=CHANGE_ME_HIGH_ENTROPY_TOKEN
DOCQA_USER_SERVICE_URI=http://127.0.0.1:18081
DOCQA_DOCUMENT_SERVICE_URI=http://127.0.0.1:18082
DOCQA_REMINDER_SERVICE_URI=http://127.0.0.1:18083
DOCQA_PYTHON_BASE_URL=http://127.0.0.1:18000

# ===== Python 数据面 =====
DOCQA_AI_EMBEDDING_PROVIDER=offline
DOCQA_AI_EXPERIMENT_BUDGET=2000
DOCQA_AI_EXPERIMENT_TOKEN_BUDGET=4000000
DOCQA_AI_LLM_API_KEY=CHANGE_ME_LLM_API_KEY
DOCQA_AI_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DOCQA_AI_LLM_MODEL=qwen-plus
DOCQA_AI_LLM_PROVIDER=openai
DOCQA_AI_LLM_TIMEOUT_MS=15000
DOCQA_AI_MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
DOCQA_AI_MINIO_BUCKET=docqa-documents
DOCQA_AI_MINIO_ENABLED=true
DOCQA_AI_MINIO_ENDPOINT=http://127.0.0.1:19100
DOCQA_AI_MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
DOCQA_AI_MQ_ENABLED=true
DOCQA_AI_PG_DSN=postgresql://docqa:CHANGE_ME_PG_PASSWORD@127.0.0.1:15432/docqa_vec
DOCQA_AI_REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:16380/0
DOCQA_AI_ROCKETMQ_NAMESRV=127.0.0.1:19876

# ===== compose 插值用（端口与容器凭据，须与上面保持一致）=====
DOCQA_DB_PORT=13306
DOCQA_PG_PORT=15432
DOCQA_PG_PASSWORD=CHANGE_ME_PG_PASSWORD
DOCQA_REDIS_CONTAINER_PORT=16379
DOCQA_MINIO_PORT=19100
DOCQA_MINIO_CONSOLE_PORT=19101
DOCQA_MINIO_CONTAINER_PORT=9100
DOCQA_MINIO_CONTAINER_CONSOLE_PORT=9101
DOCQA_ROCKETMQ_NAMESRV_PORT=19876
DOCQA_ROCKETMQ_BROKER_PORT=20911
DOCQA_ROCKETMQ_VIP_PORT=20909
DOCQA_AI_PORT=18000
