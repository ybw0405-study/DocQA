# DocQA 本地开发配置模板
#
# 用法：复制本文件为同目录下的 local.env（gitignored），按需填写。
#   Copy-Item ops/env/local.env.example ops/env/local.env
# start-dev.ps1 会逐行读取 local.env 并注入「进程作用域」环境变量，
# 脚本退出后变量即消失；本文件是唯一事实来源，不再写 Windows User/Machine 全局作用域。
#
# 端口段与其他本地项目完全错开，可同时启动：
#   MySQL 13306 / PG 15432 / Redis 16380 / MinIO 19100,19101
#   RocketMQ 19876,20911,20909 / Python 18000 / Java 18080-18083 / Vite 5173
#   LangFuse（可选，-WithLangfuse）13000 / ClickHouse 18123 / 队列 Redis 16381
# 全部绑定 127.0.0.1，地址永不漂移（不再依赖 WSL eth0 IP）。
#
# 注意：值里的 # ? % @ $ 都是字面量，解析器只跳过「行首 #」的注释行，
# 不做行内注释剥离，不要给值加引号。

# ===== 数据库 =====
DOCQA_DB_URL=jdbc:mysql://127.0.0.1:13306/docqa?useSSL=false&allowPublicKeyRetrieval=true&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=utf8
DOCQA_DB_USERNAME=root
DOCQA_DB_PASSWORD=CHANGE_ME_ROOT_PASSWORD
DOCQA_APP_DB_USERNAME=ss_app
DOCQA_APP_DB_PASSWORD=CHANGE_ME_APP_PASSWORD
DOCQA_MIGRATOR_DB_USERNAME=ss_migrator
DOCQA_MIGRATOR_DB_PASSWORD=CHANGE_ME_MIGRATOR_PASSWORD
DOCQA_AUDIT_DB_USERNAME=ss_audit
DOCQA_AUDIT_DB_PASSWORD=CHANGE_ME_AUDIT_PASSWORD

# ===== 中间件端点 =====
DOCQA_REDIS_HOST=127.0.0.1
DOCQA_REDIS_PORT=16380
DOCQA_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
DOCQA_REDIS_DATABASE=0
DOCQA_MINIO_ENDPOINT=http://127.0.0.1:19100
DOCQA_MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
DOCQA_MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
DOCQA_MINIO_BUCKET=docqa-documents
DOCQA_MINIO_ENABLED=true
DOCQA_ROCKETMQ_NAMESRV=127.0.0.1:19876
DOCQA_ROCKETMQ_ENABLED=true

# ===== 应用配置 =====
# ---- 生产判据（B2：默认最严，仅显式 dev/local/test 才放宽）----
# 未设置、或值非 dev/local/test，一律按 prod 处理：内部 token 必填（空则 fail-fast
# 拒绝启动）、api_host 仅 loopback、metrics 不对外。本模板给最安全的默认值 prod；
# 本地联调若需放宽，显式改为 local。
DOCQA_ENV=prod
# Python 数据面环境标记，与 DOCQA_ENV 一并参与生产判定；生产部署设为 prod。
DOCQA_AI_ENVIRONMENT=prod
# 网关 → Python 内部鉴权共享密钥。示例值仅为占位符（不可当真实密钥使用），
# 务必替换为高熵随机值，且网关与 Python 两侧必须一致。
# 生产模式（DOCQA_ENV=prod）留空会 fail-fast 拒绝启动。
DOCQA_AI_INTERNAL_TOKEN=CHANGE_ME_REPLACE_WITH_A_RANDOM_SECRET
DOCQA_JWT_SECRET=CHANGE_ME_JWT_SECRET
DOCQA_DEMO_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH
# 本地演示需要种子 ADMIN 时显式打开；默认两个开关均为 false
# DOCQA_DEMO_USER_ENABLED=true
# DOCQA_DEMO_ADMIN=true
DOCQA_DEMO_USERNAME=demo
DOCQA_DEMO_USER_ID=00000000-0000-0000-0000-000000000001
DOCQA_AUDIT_ENABLED=true
# 生产部署建议关闭自助注册；本地演示可保持 true
DOCQA_SELF_REGISTRATION_ENABLED=true
# 允许自助注册的租户 slug 白名单（逗号分隔）；默认只放行默认租户，
# 新增租户须由运维显式放开。user-service 一直在读这个变量，模板此前漏登记（G11 对账缺口）。
DOCQA_REGISTRATION_ALLOWED_SLUGS=default
DOCQA_COOKIE_SECURE=false
# 自检默认 enforce；本地 DB 尚未做权限收敛时可临时放宽为 warn（生产禁止放宽）
DOCQA_AUDIT_APPEND_ONLY_GUARD=warn
# 可选：租户供给 bootstrap 端点令牌，留空即禁用（默认安全，勿提交真实值）。
# 需要供给第二个真实租户时才填写高熵值，并走 out-of-band 运维直连 user-service。
# DOCQA_TENANT_BOOTSTRAP_TOKEN=CHANGE_ME_HIGH_ENTROPY_TOKEN
DOCQA_USER_SERVICE_URI=http://127.0.0.1:18081
DOCQA_DOCUMENT_SERVICE_URI=http://127.0.0.1:18082
DOCQA_REMINDER_SERVICE_URI=http://127.0.0.1:18083
DOCQA_PYTHON_BASE_URL=http://127.0.0.1:18000

# ===== Python 数据面 =====
# 【真实语义检索开关（必读）】
# 默认 embedding/llm/rerank 中 embedding 与 rerank 是 offline（哈希向量 + noop 重排），
# 这意味着「语义检索质量数字不存在」——检索只按特征哈希匹配，不是向量语义召回。
# 要启用真实语义 RAG，必须把下面三项 provider 都切到真实实现并填 key：
#   1) DOCQA_AI_EMBEDDING_PROVIDER=openai  + DOCQA_AI_EMBEDDING_BASE_URL/API_KEY/MODEL
#   2) DOCQA_AI_LLM_PROVIDER=openai        + DOCQA_AI_LLM_BASE_URL/API_KEY/MODEL
#   3) DOCQA_AI_RERANK_PROVIDER=dashscope  + DOCQA_AI_RERANK_BASE_URL/API_KEY/MODEL
# 三项任一为真实 provider 时，DOCQA_AI_EXPERIMENT_BUDGET 与 _TOKEN_BUDGET 必须 > 0，
# 否则启动即 fail-fast（防止「额度 0 ⇒ 每个请求都软降级」的假死组合）。
# 注意：仅切 LLM、不切 embedding，检索仍是 offline 哈希——LLM 再强也是垃圾进垃圾出。
#
# 【三条真实链路已实测验证（2026-11-21，仅内存注入、未落盘）】
#   embedding：DOCQA_AI_EMBEDDING_PROVIDER=openai
#       BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#       MODEL=text-embedding-v3（实测返回 1024 维，须与 DIMENSIONS=1024 一致）
#   llm：DOCQA_AI_LLM_PROVIDER=openai
#       阿里云 BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  MODEL=qwen-plus
#       或 DeepSeek BASE_URL=https://api.deepseek.com/v1  MODEL=deepseek-chat（实测均通）
#   rerank：DOCQA_AI_RERANK_PROVIDER=dashscope（见下方 rerank 段，模型用 gte-rerank-v2）
DOCQA_AI_EMBEDDING_PROVIDER=offline
DOCQA_AI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DOCQA_AI_EMBEDDING_API_KEY=CHANGE_ME_EMBEDDING_API_KEY
DOCQA_AI_EMBEDDING_MODEL=text-embedding-v3
DOCQA_AI_EMBEDDING_DIMENSIONS=1024
DOCQA_AI_EXPERIMENT_BUDGET=2000
DOCQA_AI_EXPERIMENT_TOKEN_BUDGET=4000000
DOCQA_AI_LLM_API_KEY=CHANGE_ME_LLM_API_KEY
DOCQA_AI_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DOCQA_AI_LLM_MODEL=qwen-plus
DOCQA_AI_LLM_PROVIDER=openai
# 【rerank 已实测验证（2026-11-21）】走阿里云 DashScope 原生 rerank 端点：
#   - 端点：/api/v1/services/rerank/text-rerank/text-rerank（不是 OpenAI 兼容面）
#   - 参数：input.query + input.documents 嵌套结构（代码里 DashScopeRerankProvider 已按此实现）
#   - 模型：必须用 gte-rerank-v2！gte-rerank（v1）会返回 403 AccessDenied（该 key 未开通 v1）。
#     实测：gte-rerank-v2 + input.query 格式 → HTTP 200，正确返回 relevance_score 排序。
#   切换到真实 rerank：DOCQA_AI_RERANK_PROVIDER=dashscope 并填 API_KEY。
DOCQA_AI_RERANK_PROVIDER=offline
DOCQA_AI_RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
DOCQA_AI_RERANK_API_KEY=CHANGE_ME_RERANK_API_KEY
DOCQA_AI_RERANK_MODEL=gte-rerank-v2
DOCQA_AI_LLM_TIMEOUT_MS=15000
# 工具调用协议：json（默认，提示词约束）/ native（OpenAI 兼容 function tools）
DOCQA_AI_TOOL_PROTOCOL=json
# 人在回路：高风险工具执行前 interrupt 挂起，等批准/拒绝续跑（依赖 checkpoint_enabled=true）
DOCQA_AI_TOOL_APPROVAL_ENABLED=false
# 高风险工具名单：精确名或前缀通配（如 mcp__*），逗号分隔
DOCQA_AI_HIGH_RISK_TOOLS=
DOCQA_AI_MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
DOCQA_AI_MINIO_BUCKET=docqa-documents
DOCQA_AI_MINIO_ENABLED=true
DOCQA_AI_MINIO_ENDPOINT=http://127.0.0.1:19100
DOCQA_AI_MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
DOCQA_AI_MQ_ENABLED=true
DOCQA_AI_PG_DSN=postgresql://docqa:CHANGE_ME_PG_PASSWORD@127.0.0.1:15432/docqa_vec
DOCQA_AI_REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:16380/0
DOCQA_AI_ROCKETMQ_NAMESRV=127.0.0.1:19876

# ===== 模型连接（在界面里配置生成模型）=====
# 管理员在 /admin/model-connections 选厂商预设、填自己的 API Key：凭据以 AES-256-GCM
# 密文落库，网关把密文发布到 Redis，数据面按请求解密并选模型——改模型不再需要改上面的
# DOCQA_AI_LLM_* 再重启。上面的 env 配置退化为「该租户没有界面连接时」的回退。
#
# 凭据主密钥：base64 编码的 32 字节，网关与 Python 数据面必须是同一把，否则密文解不开。
# 本地由 start-dev.ps1 首次启动时自动生成并写入 local.env（gitignored，绝不打印、绝不入库）；
# 生产部署必须自行注入高熵值。留空 = 未配置：服务照常启动，只有「保存 API Key」与
# 「测试连接」会被明确拒绝，其余功能不受影响。
# 手工生成：python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
DOCQA_CRED_MASTER_KEY=
# 主密钥轮换：把旧密钥填这里（逗号分隔可多个），历史密文仍可解；
# 每条连接都重新录入 Key 之后才能移除旧密钥，否则那些连接会硬失败（不会静默降级）。
DOCQA_CRED_MASTER_KEY_PREVIOUS=
# 出网主机后缀白名单（逗号分隔）；留空 = 放行任意公网主机。私网/回环仍由下面的开关决定。
# 网关探测与数据面真实调用读同一份取值，两侧判定必须一致。
DOCQA_LLM_ALLOWED_HOSTS=
# 本地 Ollama 等自托管端点需要显式放行回环/私网；生产保持 false。
DOCQA_LLM_ALLOW_PRIVATE=false
# 数据面开关：打开后才按请求解析界面配置的连接；关闭时行为与改动前逐字节一致。
# start-dev.ps1 会在本地运行时显式打开。打开时即使 env 三个 provider 全 offline，
# 也要求 DOCQA_AI_EXPERIMENT_BUDGET 与 _TOKEN_BUDGET > 0——界面激活的真实外呼必须受额度约束。
# DOCQA_AI_MODEL_CONNECTIONS_ENABLED=true

# ===== LangFuse v3 自托管追踪（可选，默认整体关闭）=====
# 四个容器全部挂 compose 的 langfuse profile：默认启动不拉起（ClickHouse + worker
# 约 +2–3GB 内存），只有 scripts/start-dev.ps1 -WithLangfuse 才启动并自动初始化
# （建 langfuse 库 / minio bucket / 首启 bootstrap 组织、项目与下面这对 API 密钥）。
# 本地秘密（NEXTAUTH_SECRET/SALT/ENCRYPTION_KEY/两个口令/密钥对）由 start-dev.ps1
# 首次 -WithLangfuse 时自动生成并写回 local.env（gitignored，绝不打印）；
# 生产部署必须自行注入高熵值。ENCRYPTION_KEY 是 64 位十六进制（32 字节），
# 手工生成：python -c "import os;print(os.urandom(32).hex())"
DOCQA_LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME_LANGFUSE_NEXTAUTH_SECRET
DOCQA_LANGFUSE_SALT=CHANGE_ME_LANGFUSE_SALT
DOCQA_LANGFUSE_ENCRYPTION_KEY=CHANGE_ME_LANGFUSE_ENCRYPTION_KEY
DOCQA_LANGFUSE_REDIS_PASSWORD=CHANGE_ME_LANGFUSE_REDIS_PASSWORD
DOCQA_CLICKHOUSE_PASSWORD=CHANGE_ME_CLICKHOUSE_PASSWORD
DOCQA_LANGFUSE_INIT_USER_PASSWORD=CHANGE_ME_LANGFUSE_INIT_USER_PASSWORD
# 首启 bootstrap 的项目密钥对；Python 数据面导出用同一对取值（见下方 DOCQA_AI_LANGFUSE_*）。
DOCQA_LANGFUSE_INIT_PUBLIC_KEY=CHANGE_ME_LANGFUSE_INIT_PUBLIC_KEY
DOCQA_LANGFUSE_INIT_SECRET_KEY=CHANGE_ME_LANGFUSE_INIT_SECRET_KEY
# 网关下发给管理面的 LangFuse 入口地址；留空 = 禁用（审计页 traceId 保持纯文本）。
# -WithLangfuse 时 start-dev.ps1 会在本次运行内注入 http://127.0.0.1:${DOCQA_LANGFUSE_PORT}。
DOCQA_LANGFUSE_BASE_URL=
# Python 数据面第二路 OTLP 导出（既有管道不动）。默认关闭 = 行为与改动前逐字节一致。
DOCQA_AI_LANGFUSE_TRACING_ENABLED=false
DOCQA_AI_LANGFUSE_OTLP_ENDPOINT=http://127.0.0.1:13000/api/public/otel/v1/traces
DOCQA_AI_LANGFUSE_PUBLIC_KEY=CHANGE_ME_LANGFUSE_INIT_PUBLIC_KEY
DOCQA_AI_LANGFUSE_SECRET_KEY=CHANGE_ME_LANGFUSE_INIT_SECRET_KEY
# 非回环 endpoint 需要显式放行（照 DOCQA_LLM_ALLOW_PRIVATE 的口径）；生产保持 false。
DOCQA_AI_LANGFUSE_ALLOW_PRIVATE=false

# ===== compose 插值用（端口与容器凭据，须与上面保持一致）=====
DOCQA_DB_PORT=13306
DOCQA_PG_PORT=15432
DOCQA_PG_PASSWORD=CHANGE_ME_PG_PASSWORD
DOCQA_REDIS_CONTAINER_PORT=16379
DOCQA_MINIO_PORT=19100
DOCQA_MINIO_CONSOLE_PORT=19101
DOCQA_MINIO_CONTAINER_PORT=9100
DOCQA_MINIO_CONTAINER_CONSOLE_PORT=9101
DOCQA_ROCKETMQ_NAMESRV_PORT=19876
DOCQA_ROCKETMQ_BROKER_PORT=20911
DOCQA_ROCKETMQ_VIP_PORT=20909
DOCQA_AI_PORT=18000
# 全容器交付（start-dev.ps1 -Containers / ops/docker-compose.app.yml）宿主映射端口
DOCQA_GATEWAY_PORT=18080
DOCQA_WEB_PORT=18090
# GHCR 镜像 tag（与 release 版本同步；本地 build 覆盖 image 时忽略）
DOCQA_IMAGE_TAG=2.1.0
# LangFuse 面（-WithLangfuse 才启动）：web 13000 / ClickHouse HTTP 18123 / 队列 Redis 16381
DOCQA_LANGFUSE_PORT=13000
DOCQA_CLICKHOUSE_HTTP_PORT=18123
DOCQA_LANGFUSE_REDIS_PORT=16381
